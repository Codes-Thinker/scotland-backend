# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fnt_app
DB_PASSWORD=change-me
DB_NAME=fnt_dev
DB_SSL=false
DB_SYNCHRONIZE=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-random-characters-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Object storage (local disk in development; S3 in production)
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# Dispatch
DISPATCH_SWEEP_MS=5000
DISPATCH_OFFER_SECONDS=20
DISPATCH_RADIUS_KM=15
DISPATCH_MAX_OFFERS=3
DISPATCH_LOCATION_MAX_AGE_SEC=600
